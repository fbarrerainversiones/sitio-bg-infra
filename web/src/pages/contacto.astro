---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SelectorContacto from "../components/SelectorContacto.astro";
import { Picture } from "astro:assets";
import fotoFrancisco from "../assets/francisco-barrera.jpg";

/**
 * SESION 19 — el CTA generico unico se reemplaza por el selector de producto.
 *
 * Antes esta pagina preguntaba «¿quieres escribirme?» y ofrecia un solo boton
 * de WhatsApp con un mensaje generico y SIN marcador de atribucion. Ahora
 * pregunta «¿por donde empezamos?» y ofrece cinco caminos, cada uno con su
 * mensaje escrito y su marcador BG-CTA-*, asi que del otro lado se sabe que
 * eligio el lead y no solo de donde vino.
 *
 * La foto entra junto al titulo con el tratamiento que ya usa /sobre-mi
 * (recorte 4/5, borde dorado tenue, velo inferior). Va en `eager` con
 * `fetchpriority="high"` porque en movil es el primer elemento de la pagina,
 * o sea el candidato a LCP: ponerla en `lazy` es el antipatron que Lighthouse
 * marca como «LCP image was lazily loaded».
 */

const TITLE = "Contacto · Barrera Global · Asesoría en seguros en Ecuador";
const DESCRIPTION = "Conversa por WhatsApp o correo con Barrera Global. Asesoría en seguros de vida, salud, vehicular e inversión en Ecuador. Sin presión, sin compromiso.";
---

<Layout title={TITLE} description={DESCRIPTION}>

  <Header />

  <main class="border-t border-gd-muted">

    <!-- HERO: foto + titulo -->
    <section class="pt-20 md:pt-28 pb-10 md:pb-14">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-center">

          <div class="md:col-span-4 w-full max-w-[220px] md:max-w-none mx-auto">
            <div class="relative aspect-[4/5] overflow-hidden rounded-sm border border-gd-muted">
              <Picture
                src={fotoFrancisco}
                formats={["avif", "webp"]}
                widths={[240, 340, 480, 680]}
                sizes="(min-width: 768px) 340px, 220px"
                alt="Francisco Barrera, Asesor Productor de Seguros en Ambato, Ecuador"
                width={1000}
                height={1000}
                class="w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                pictureAttributes={{ class: "block w-full h-full" }}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-bg/30 to-transparent"></div>
            </div>
          </div>

          <div class="md:col-span-8 text-center md:text-left">
            <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
              Contacto
            </p>

            <h1 class="text-5xl md:text-7xl font-display font-semibold text-tx mb-6 leading-tight">
              Hablemos.
            </h1>

            <p class="font-body text-base md:text-lg text-tx-muted leading-relaxed max-w-xl mx-auto md:mx-0">
              La conversación empieza por WhatsApp. Sin presión, sin compromiso.
              Te respondo en horario laboral Ecuador.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- El selector reemplaza al boton generico. Sin antetitulo: el hero de
         arriba ya dijo «Contacto». -->
    <SelectorContacto antetitulo={false} />

    <!-- Correo, aviso legal y salida -->
    <section class="pb-24 md:pb-32">
      <div class="max-w-3xl mx-auto px-6 text-center">

        <p class="font-body text-base text-tx-muted">
          También puedes escribirme por correo a
          <a
            href="mailto:contacto@barreraglobal.com"
            class="link-underline text-gd hover:text-gd-light transition-colors"
          >contacto@barreraglobal.com</a>
        </p>

        <!-- Disclaimer legal -->
        <p class="font-body text-sm text-tx-muted mt-12 pt-8 border-t border-gd-muted max-w-xl mx-auto leading-relaxed">
          Los mensajes de WhatsApp los atiende inicialmente <span class="text-tx">Aurora</span>,
          un asistente automatizado. Tus datos se tratan conforme a la Ley Orgánica de
          Protección de Datos Personales (LOPDP) del Ecuador. Revisa nuestra
          <a
            href="/privacidad"
            class="link-underline text-gd hover:text-gd-light transition-colors"
          >Política de Privacidad</a>.
        </p>

        <!-- Volver al inicio -->
        <div class="mt-16">
          <a
            href="/"
            class="link-underline inline-flex items-center gap-2 text-sm font-mono text-gd hover:text-gd-light transition-colors"
          >
            ← Volver al inicio
          </a>
        </div>

      </div>
    </section>

  </main>

  <Footer />

</Layout>
