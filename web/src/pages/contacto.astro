---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { enlaceWhatsApp } from "../lib/whatsapp";

// Sin marcador: la lista acordada con Aurora tiene ocho tokens y /contacto no
// esta entre ellos. El enlace sale con su mensaje propio y sin atribucion.
const WHATSAPP_URL = enlaceWhatsApp(
  "Hola, llego desde la página de contacto de barreraglobal.com y quiero conversar."
);

const TITLE = "Contacto · Barrera Global · Asesoría en seguros en Ecuador";
const DESCRIPTION = "Conversa por WhatsApp o correo con Barrera Global. Asesoría en seguros de vida, salud e inversión en Ecuador. Sin presión, sin compromiso.";
---

<Layout title={TITLE} description={DESCRIPTION}>

  <Header />

  <main class="border-t border-gd-muted">

    <section class="py-24 md:py-32">
      <div class="max-w-3xl mx-auto px-6 text-center">

        <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
          Contacto
        </p>

        <h1 class="text-5xl md:text-7xl font-display font-semibold text-tx mb-6 leading-tight">
          Hablemos.
        </h1>

        <p class="font-body text-base md:text-lg text-tx-muted leading-relaxed mb-12 max-w-xl mx-auto">
          La conversación empieza por WhatsApp. Sin presión, sin compromiso.
          Te respondo en horario laboral Ecuador.
        </p>

        <!-- CTA principal: WhatsApp -->
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-lift inline-flex items-center justify-center gap-2 bg-gd px-8 py-4 rounded-md font-body font-medium text-base hover:bg-gd-light transition-colors"
          style="color:#08080d"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          <span>Escribir por WhatsApp</span>
        </a>

        <!-- Alternativa: correo -->
        <p class="font-body text-base text-tx-muted mt-10">
          También puedes escribirme por correo a
          <a
            href="mailto:contacto@barreraglobal.com"
            class="link-underline text-gd hover:text-gd-light transition-colors"
          >contacto@barreraglobal.com</a>
        </p>

        <!-- Disclaimer legal -->
        <p class="font-body text-sm text-tx-muted mt-16 pt-8 border-t border-gd-muted max-w-xl mx-auto leading-relaxed">
          Los mensajes de WhatsApp los atiende inicialmente <span class="text-tx">Aurora</span>,
          un asistente automatizado. Tus datos se tratan conforme a la Ley Orgánica de
          Protección de Datos Personales (LOPDP) del Ecuador. Revisa nuestra
          <a
            href="/privacidad"
            class="link-underline text-gd hover:text-gd-light transition-colors"
          >Política de Privacidad</a>.
        </p>

        <!-- Volver al inicio -->
        <div class="mt-16">
          <a
            href="/"
            class="link-underline inline-flex items-center gap-2 text-sm font-mono text-gd hover:text-gd-light transition-colors"
          >
            ← Volver al inicio
          </a>
        </div>

      </div>
    </section>

  </main>

  <Footer />

</Layout>
