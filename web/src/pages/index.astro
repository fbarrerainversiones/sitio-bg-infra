---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const WHATSAPP_AURORA = "593998027819";
const WHATSAPP_MESSAGE = encodeURIComponent(
  "Hola, llego desde barreraglobal.com y quiero conversar."
);
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_AURORA}?text=${WHATSAPP_MESSAGE}`;

const TITLE = "Barrera Global · Asesoria en seguros, vida e inversion en Ecuador";
const DESCRIPTION = "Asesoria especializada en seguros de vida, salud e inversion en Ecuador. Patrimonio que crece. Capital protegido.";
---

<Layout title={TITLE} description={DESCRIPTION}>

  <Header />

  <main>

    <section class="relative min-h-[80vh] flex items-center">
      <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">

        <p class="font-mono text-xs text-gd uppercase tracking-widest mb-6">
          Asesoria Productora de Seguros · Ecuador
        </p>

        <h1 class="text-5xl md:text-7xl font-display font-semibold leading-tight tracking-tight text-tx mb-6">
          Patrimonio que crece.
          <br />
          <span class="text-gd">Capital protegido.</span>
        </h1>

        <p class="font-body text-lg md:text-xl text-tx-muted max-w-2xl leading-relaxed mb-10">
          Asesoria especializada en seguros de vida, salud e inversion.
          Sin promesas vacias, sin presion, sin compromiso. Solo informacion clara
          para que tomes la mejor decision para tu familia y tu patrimonio.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-gd text-[#08080d] px-7 py-4 rounded-md font-body font-medium text-base hover:bg-gd-light transition-colors" style="color:#08080d"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            <span>Conversar por WhatsApp</span>
          </a>
          <a
            href="#productos"
            class="inline-flex items-center justify-center gap-2 border border-gd text-gd px-7 py-4 rounded-md font-body font-medium text-base hover:bg-gd hover:text-[#08080d] transition-colors"
          >
            Ver productos
          </a>
        </div>

      </div>
    </section>

    <section id="productos" class="border-t border-gd-muted py-24">
      <div class="max-w-5xl mx-auto px-6">
        <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
          Productos
        </p>
        <h2 class="text-4xl md:text-5xl font-display font-semibold text-tx mb-6">
          Tres pilares.
          <span class="text-gd">Una estrategia.</span>
        </h2>
        <p class="font-body text-base text-tx-muted max-w-2xl leading-relaxed">
          (Contenido real en BLOQUE 4: seguros de vida + salud + inversion
          con descripcion detallada de cada producto)
        </p>
      </div>
    </section>

    <section id="sobre-mi" class="border-t border-gd-muted py-24 bg-bg-elev-1">
      <div class="max-w-5xl mx-auto px-6">
        <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
          Sobre mi
        </p>
        <h2 class="text-4xl md:text-5xl font-display font-semibold text-tx mb-6">
          Francisco Barrera.
          <span class="text-gd">Asesor Productor de Seguros.</span>
        </h2>
        <p class="font-body text-base text-tx-muted max-w-2xl leading-relaxed">
          (Bio real en BLOQUE 4: experiencia, credenciales, valores,
          por que elegir un asesor independiente bajo broker)
        </p>
      </div>
    </section>

    <section id="contacto" class="border-t border-gd-muted py-24">
      <div class="max-w-5xl mx-auto px-6 text-center">
        <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
          Contacto
        </p>
        <h2 class="text-4xl md:text-5xl font-display font-semibold text-tx mb-6">
          Hablemos.
        </h2>
        <p class="font-body text-base text-tx-muted max-w-xl mx-auto leading-relaxed mb-10">
          La conversacion empieza por WhatsApp. Sin presion.
          Te respondemos en horario laboral Ecuador.
        </p>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-gd text-[#08080d] px-8 py-4 rounded-md font-body font-medium text-base hover:bg-gd-light transition-colors" style="color:#08080d"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          <span>Escribir por WhatsApp</span>
        </a>
      </div>
    </section>

  </main>

  <Footer />

</Layout>





