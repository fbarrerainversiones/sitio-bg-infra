---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { enlaceWhatsApp } from "../lib/whatsapp";

// Sin marcador, por la misma razon que /contacto: la lista acordada con Aurora
// tiene ocho tokens y /404 no esta entre ellos.
const WHATSAPP_URL = enlaceWhatsApp(
  "Hola, llego desde barreraglobal.com y quiero conversar."
);

const TITLE = "Página no encontrada · Barrera Global";
const DESCRIPTION =
  "La página que buscas no existe o cambio de dirección. Vuelve al inicio o conversa por WhatsApp con Barrera Global.";
---

<Layout title={TITLE} description={DESCRIPTION} noindex={true}>

  <Header />

  <main class="border-t border-gd-muted">

    <section class="min-h-[70vh] flex items-center py-24 md:py-32">
      <div class="max-w-3xl mx-auto px-6 text-center">

        <p class="font-display text-7xl md:text-9xl font-semibold text-gd leading-none mb-8">
          404
        </p>

        <h1 class="text-4xl md:text-6xl font-display font-semibold text-tx mb-6 leading-tight">
          Esta página no existe.
        </h1>

        <p class="font-body text-base md:text-lg text-tx-muted leading-relaxed mb-12 max-w-xl mx-auto">
          Puede que el enlace este roto o que la página haya cambiado de
          dirección. Nada grave: aquí tienes por dónde seguir.
        </p>

        <!-- Navegacion de retorno -->
        <nav class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 mb-12" aria-label="Navegación de la página 404">
          <a href="/" class="link-underline font-body text-sm text-gd hover:text-gd-light transition-colors">
            Inicio
          </a>
          <a href="/#productos" class="link-underline font-body text-sm text-gd hover:text-gd-light transition-colors">
            Productos
          </a>
          <a href="/sobre-mi" class="link-underline font-body text-sm text-gd hover:text-gd-light transition-colors">
            Sobre mí
          </a>
          <a href="/contacto" class="link-underline font-body text-sm text-gd hover:text-gd-light transition-colors">
            Contacto
          </a>
        </nav>

        <!-- CTA WhatsApp -->
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-lift inline-flex items-center justify-center gap-2 bg-gd px-8 py-4 rounded-md font-body font-medium text-base hover:bg-gd-light transition-colors"
          style="color:#08080d"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          <span>Conversar por WhatsApp</span>
        </a>

      </div>
    </section>

  </main>

  <Footer />

</Layout>
