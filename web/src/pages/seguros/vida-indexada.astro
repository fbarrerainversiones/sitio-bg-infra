---
import ProductLayout from "../../layouts/ProductLayout.astro";
import heroImage from "../../assets/productos/vida-indexada.jpg";
// RESTAURAR-CON-CONTENIDO-REAL
// import Pendiente from "../../components/Pendiente.astro";
---

<ProductLayout
  title="Vida indexada · Seguros de vida · Barrera Global"
  description="Seguro de vida indexada en Ecuador: protección mas acumulación vinculada a índices, para construir patrimonio a largo plazo. Cotización personalizada."
  canonical="https://barreraglobal.com/seguros/vida-indexada"
  eyebrow="Seguros de vida"
  productName="Vida indexada"
  heroSubtitle="Protección para tu familia y acumulación vinculada a índices. Cubrir hoy y construir patrimonio a largo plazo."
  whatsappMessage="Hola, llego desde la página de Vida indexada de barreraglobal.com y quiero conversar."
  slug="vida-indexada"
  heroImage={heroImage}
  heroImageAlt="Ciudad al atardecer vista a través del ventanal de un piso alto"
>
  <p>
    La <span class="text-tx font-medium">vida indexada</span> combina dos
    objetivos: proteger a tu familia y, a la vez, acumular con un componente
    vinculado a índices. Además de la cobertura, busca construir patrimonio a
    largo plazo.
  </p>
  <p>
    Es protección con horizonte: cubre hoy y trabaja para el mañana.
  </p>

  {/* RESTAURAR-CON-CONTENIDO-REAL — 2 bloques ocultos para el lanzamiento publico.
      Se comentan con {} y no con <!-- -->, porque los comentarios HTML SI llegan
      al build y estas notas son internas. Descomentar (y el import de arriba)
      cuando Francisco defina el contenido real. NO borrar.

  <Pendiente>decisión Francisco — para quien es ideal la vida indexada: perfil objetivo, edades y horizonte típico.</Pendiente>
  <Pendiente>decisión Francisco — profundidad del producto: como funciona la indexación, coberturas, exclusiones y condiciones. Sin cifras, sin rendimientos ni carriers hasta tu visto bueno.</Pendiente>
  */}
</ProductLayout>
