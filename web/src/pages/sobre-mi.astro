---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Picture } from "astro:assets";
import fotoFrancisco from "../assets/francisco-barrera.jpg";
import FondoVideo from "../components/FondoVideo.astro";
import sobreMiPoster from "../assets/sobre-mi-poster.jpg";

const WHATSAPP_AURORA = "593998027819";
const WHATSAPP_MESSAGE = encodeURIComponent(
  "Hola Francisco, llego desde la página Sobre mi de barreraglobal.com y quiero conversar."
);
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_AURORA}?text=${WHATSAPP_MESSAGE}`;

const TITLE = "Sobre mi · Francisco Barrera · Arquitectura financiera";
const DESCRIPTION = "Francisco Javier Barrera Bonilla. Ingeniero de sistemas y Asesor Productor de Seguros en Ambato, Ecuador. Disciplina técnica aplicada a seguros, vida e inversión.";
---

<Layout title={TITLE} description={DESCRIPTION}>

  <Header />

  <main>

    {/* HERO PERSONAL — F3: el loop de oficina entra como capa visual.
        NO se toca una palabra del texto ni la estructura: la foto de
        Francisco sigue siendo la protagonista humana y la credencial SCVS
        queda tal cual. Lo unico que cambia es lo que hay DETRAS.

        `bv-en-elev` porque esta seccion va sobre `bg-bg-elev-1`: sin eso el
        velo inferior moriria contra `--bg` y se veria un escalon de color
        justo donde termina la banda.

        Comentario con {} y no con <!-- -->: los HTML llegan al build. */}
    <section class="relative min-h-[90vh] flex items-center overflow-hidden bg-bg-elev-1 bv-en-elev">

      <FondoVideo video="/videos/sobre-mi-loop.mp4" poster={sobreMiPoster} />

      <div class="relative z-10 max-w-6xl mx-auto px-6 py-24 md:py-32 w-full">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">

          <!-- Foto Francisco -->
          <div class="md:col-span-5 reveal">
            <div class="relative aspect-[4/5] overflow-hidden rounded-sm border border-gd-muted">
              {/* P-44 — AVIF/WebP + srcset via astro:assets.

                  El <picture> hereda `w-full h-full` porque el <img> lleva
                  `h-full`: sin eso mediria contra un padre inline de alto
                  automatico y el recorte 4/5 se rompe.

                  SIGUE EN eager + fetchpriority="high", NO en lazy: en esta
                  pagina la foto es el primer elemento de la grilla, o sea que
                  en movil (grid-cols-1) abre la pagina y es el elemento LCP.
                  Ponerla en lazy es el antipatron que Lighthouse marca como
                  "LCP image was lazily loaded". Ver el reporte de sesion. */}
              <Picture
                src={fotoFrancisco}
                formats={["avif", "webp"]}
                widths={[400, 720, 1000]}
                sizes="(min-width: 768px) 440px, 100vw"
                alt="Francisco Barrera, Asesor Productor de Seguros en Ambato, Ecuador"
                width={1000}
                height={1000}
                class="w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                pictureAttributes={{ class: "block w-full h-full" }}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-bg-elev-1/30 to-transparent"></div>
            </div>
          </div>

          <!-- Hero text -->
          <div class="md:col-span-7">

            <p class="hero-entrance font-mono text-xs text-gd uppercase tracking-widest mb-6">
              Asesor Productor de Seguros · APS · Ambato
            </p>

            <h1 class="hero-entrance-delay-1 text-5xl md:text-6xl lg:text-7xl font-display font-semibold leading-tight tracking-tight text-tx mb-6">
              Francisco
              <br />
              <span class="text-gd">Barrera.</span>
            </h1>

            <p class="hero-entrance-delay-2 font-display text-2xl md:text-3xl text-tx-muted leading-tight mb-10 italic">
              Arquitectura financiera. Asesoría de seguros en Ecuador.
            </p>

            <div class="hero-entrance-delay-3 h-px w-24 bg-gd mb-8"></div>

            <p class="hero-entrance-delay-3 font-body text-base md:text-lg text-tx-muted max-w-xl leading-relaxed">
              Ingeniero de sistemas formado en la PUCE Sede Ambato.
              Asesor Productor de Seguros bajo Insurance Trust.
              Disciplina técnica aplicada a proteger lo que importa.
            </p>

          </div>

        </div>
      </div>
    </section>

    <!-- S2: QUIEN SOY -->
    <section class="border-t border-gd-muted py-24 md:py-32">
      <div class="max-w-3xl mx-auto px-6">

        <div class="reveal mb-12">
          <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
            Quién soy
          </p>
          <h2 class="text-4xl md:text-5xl font-display font-semibold text-tx leading-tight">
            Formación técnica.
            <br />
            <span class="text-gd">Vocación financiera.</span>
          </h2>
        </div>

        <div class="reveal space-y-6 font-body text-base md:text-lg text-tx-muted leading-relaxed">
          <p>
            Mi nombre es Francisco Javier Barrera Bonilla. Soy ingeniero
            de sistemas formado en la <span class="text-tx font-medium">Pontificia
            Universidad Católica del Ecuador Sede Ambato (PUCESA)</span>,
            graduado en 2019.
          </p>
          <p>
            Después de dos años trabajando en desarrollo de software, en
            octubre de 2021 di un giro deliberado hacia el sector de
            seguros, vida e inversión. No fue una decisión improvisada:
            fue la conclusión lógica de observar dónde podía aportar más
            valor con la disciplina técnica que ya tenía.
          </p>
          <p>
            Hoy opero como Asesor Productor de Seguros bajo el paraguas
            de <span class="text-tx font-medium">Insurance Trust</span>,
            broker autorizado por la Superintendencia de Compañías,
            Valores y Seguros del Ecuador (SCVS). Vivo y trabajo desde
            Ambato, Tungurahua.
          </p>
        </div>

      </div>
    </section>

    <!-- S3: POR QUE SEGUROS -->
    <section class="border-t border-gd-muted py-24 md:py-32 bg-bg-elev-1">
      <div class="max-w-3xl mx-auto px-6">

        <div class="reveal mb-12">
          <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
            Por que seguros
          </p>
          <h2 class="text-4xl md:text-5xl font-display font-semibold text-tx leading-tight">
            Del software al riesgo.
            <br />
            <span class="text-gd">Un reconocimiento.</span>
          </h2>
        </div>

        <div class="reveal space-y-6 font-body text-base md:text-lg text-tx-muted leading-relaxed">
          <p class="text-tx font-medium font-display text-xl md:text-2xl italic border-l-2 border-gd pl-6">
            La transición del software a los seguros no fue una huida:
            fue un reconocimiento.
          </p>
          <p>
            En sistemas resolvía problemas de eficiencia para empresas.
            En seguros, resuelvo algo más profundo: el riesgo que define
            la tranquilidad de una familia y la solidez de un patrimonio
            construido durante años.
          </p>
          <p>
            Pero el mercado de seguros en Ecuador tiene un problema
            crónico que se repite en cada conversación con clientes
            nuevos: no falta oferta de productos, falta claridad sobre lo
            que cada producto realmente cubre, lo que cuesta, lo que
            excluye, y por qué un asesor recomienda uno sobre otro.
          </p>
          <p>
            Decidí que ahí era donde podía aportar diferencia real.
          </p>
        </div>

      </div>
    </section>

    <!-- S4: COMO TRABAJO -->
    <section class="border-t border-gd-muted py-24 md:py-32">
      <div class="max-w-3xl mx-auto px-6">

        <div class="reveal mb-12">
          <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
            Cómo trabajo
          </p>
          <h2 class="text-4xl md:text-5xl font-display font-semibold text-tx leading-tight">
            Dos disciplinas
            <br />
            <span class="text-gd">conjugadas.</span>
          </h2>
        </div>

        <div class="reveal space-y-6 font-body text-base md:text-lg text-tx-muted leading-relaxed">
          <p>
            En Barrera Global combino dos disciplinas que pocos asesores
            en Ecuador conjugan: <span class="text-tx font-medium">análisis
            técnico de ingeniero aplicado a productos financieros</span>,
            y <span class="text-tx font-medium">automatización con
            inteligencia artificial</span> para que la asesoría llegue a
            cada cliente sin filtros comerciales artificiales.
          </p>
          <p>
            He desarrollado bots conversacionales, automatizaciones
            e-commerce con WooCommerce, y agentes de IA propios. Aurora,
            la asistente que atiende este sitio por WhatsApp, es un
            ejemplo: te responde 24/7 con respuestas reales, no
            plantillas, y escala la conversación a mi atención directa
            cuando se requiere análisis humano.
          </p>
          <p>
            Eso significa que cuando tú escribes para preguntar por un
            seguro de vida, una cobertura de salud o una cuenta de
            inversión, no entras en una cola comercial. Entras en una
            conversación. <span class="text-tx font-medium">Sin presión,
            sin compromiso, sin tiempos artificiales.</span>
          </p>
        </div>

      </div>
    </section>

    <!-- S5: EN QUE ME ESPECIALIZO -->
    <section class="border-t border-gd-muted py-24 md:py-32 bg-bg-elev-1">
      <div class="max-w-4xl mx-auto px-6">

        <div class="reveal mb-16">
          <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
            En qué me especializo
          </p>
          <h2 class="text-4xl md:text-5xl font-display font-semibold text-tx leading-tight">
            Tres líneas.
            <br />
            <span class="text-gd">Tres preguntas fundamentales.</span>
          </h2>
        </div>

        <div class="reveal grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">

          <!-- Vida -->
          <div class="space-y-4">
            <div class="flex items-center gap-3 mb-2">
              <span class="font-mono text-xs text-gd uppercase tracking-widest">01</span>
              <span class="h-px flex-grow bg-gd-muted"></span>
            </div>
            <h3 class="text-2xl font-display font-semibold text-tx">
              Seguros de vida
            </h3>
            <p class="font-body text-base text-tx-muted leading-relaxed">
              Protección financiera para la familia ante el imprevisto.
              Incluye productos de vida término (cobertura pura) y vida
              indexada (cobertura con componente de inversión).
            </p>
          </div>

          <!-- Salud -->
          <div class="space-y-4">
            <div class="flex items-center gap-3 mb-2">
              <span class="font-mono text-xs text-gd uppercase tracking-widest">02</span>
              <span class="h-px flex-grow bg-gd-muted"></span>
            </div>
            <h3 class="text-2xl font-display font-semibold text-tx">
              Seguros de salud
            </h3>
            <p class="font-body text-base text-tx-muted leading-relaxed">
              Cobertura médica nacional para Ecuador y cobertura
              internacional para quienes necesitan acceso a atención
              fuera del país.
            </p>
          </div>

          <!-- Inversion -->
          <div class="space-y-4">
            <div class="flex items-center gap-3 mb-2">
              <span class="font-mono text-xs text-gd uppercase tracking-widest">03</span>
              <span class="h-px flex-grow bg-gd-muted"></span>
            </div>
            <h3 class="text-2xl font-display font-semibold text-tx">
              Inversión
            </h3>
            <p class="font-body text-base text-tx-muted leading-relaxed">
              Estructuras de cuenta de inversión a través de carriers
              internacionales, diseñadas para hacer crecer capital con
              horizonte de mediano y largo plazo.
            </p>
          </div>

        </div>

        <div class="reveal mt-16 pt-12 border-t border-gd-muted">
          <p class="font-body text-base md:text-lg text-tx-muted leading-relaxed max-w-3xl italic">
            En cada categoría aplico el mismo principio: dimensionar bien
            antes de recomendar. <span class="text-tx font-medium">Una
            póliza mal calibrada es peor que no tener ninguna</span>,
            porque genera la falsa sensación de protección.
          </p>
        </div>

      </div>
    </section>

    <!-- S6: CON QUIEN OPERO -->
    <section class="border-t border-gd-muted py-24 md:py-32">
      <div class="max-w-3xl mx-auto px-6">

        <div class="reveal mb-12">
          <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
            Con quién opero
          </p>
          <h2 class="text-4xl md:text-5xl font-display font-semibold text-tx leading-tight">
            Estructura regulada.
            <br />
            <span class="text-gd">Responsabilidad institucional.</span>
          </h2>
        </div>

        <div class="reveal space-y-6 font-body text-base md:text-lg text-tx-muted leading-relaxed">
          <p>
            Mi vínculo profesional es con <span class="text-tx font-medium">Insurance
            Trust</span>, broker registrado ante la SCVS de Ecuador. Esa
            relación es lo que da soporte legal y operativo a cada póliza
            que coloco: detrás de mi nombre hay una estructura regulada,
            auditada y con responsabilidad institucional.
          </p>
          <p>
            En la estructura comercial,
            <span class="text-tx font-medium">Carolina Andrade</span> es la
            líder de ventas de <span class="text-tx font-medium">Insurance
            Trust</span> — el broker matriz, con sede en Quito — bajo cuya
            estructura opero desde Ambato. La conversación principal con el
            cliente, sin embargo, siempre la mantengo yo: una sola voz, una
            sola responsabilidad.
          </p>
        </div>

      </div>
    </section>

    <!-- S7: VALORES Y CODIGO ETICO -->
    <section class="border-t border-gd-muted py-24 md:py-32 bg-bg-elev-1">
      <div class="max-w-4xl mx-auto px-6">

        <div class="reveal mb-16">
          <p class="font-mono text-xs text-gd uppercase tracking-widest mb-4">
            Valores y código ético
          </p>
          <h2 class="text-4xl md:text-5xl font-display font-semibold text-tx leading-tight">
            Cuatro valores
            <br />
            <span class="text-gd">en cada conversación.</span>
          </h2>
        </div>

        <div class="reveal grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-x-16 md:gap-y-12 mb-16">

          <!-- Transparencia -->
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-gd uppercase tracking-widest">i.</span>
              <h3 class="text-xl font-display font-semibold text-tx">
                Transparencia
              </h3>
            </div>
            <p class="font-body text-base text-tx-muted leading-relaxed pl-7">
              El cliente sabe lo que paga al carrier y lo que recibe el
              asesor. Sin caja negra, sin comisiones ocultas.
            </p>
          </div>

          <!-- Disciplina -->
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-gd uppercase tracking-widest">ii.</span>
              <h3 class="text-xl font-display font-semibold text-tx">
                Disciplina
              </h3>
            </div>
            <p class="font-body text-base text-tx-muted leading-relaxed pl-7">
              Dimensiono cada cobertura con análisis técnico, no con
              presión de venta. No recomiendo lo que no entiendo a fondo.
            </p>
          </div>

          <!-- Eficiencia -->
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-gd uppercase tracking-widest">iii.</span>
              <h3 class="text-xl font-display font-semibold text-tx">
                Eficiencia
              </h3>
            </div>
            <p class="font-body text-base text-tx-muted leading-relaxed pl-7">
              Respuestas claras, sin reuniones innecesarias, sin papeleo
              redundante, sin tiempos artificiales.
            </p>
          </div>

          <!-- Respaldo -->
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-gd uppercase tracking-widest">iv.</span>
              <h3 class="text-xl font-display font-semibold text-tx">
                Respaldo
              </h3>
            </div>
            <p class="font-body text-base text-tx-muted leading-relaxed pl-7">
              Estoy presente después de la venta, no solo durante. Cuando
              llega el siniestro, la renovación o la duda técnica, sigo
              siendo tu contacto.
            </p>
          </div>

        </div>

        <!-- Frase manifiesto -->
        <div class="reveal pt-12 border-t border-gd-muted">
          <p class="font-display text-2xl md:text-3xl text-tx italic leading-tight max-w-3xl">
            Trascendemos la póliza. Custodiamos permanentemente
            <br class="hidden md:block" />
            para su tranquilidad, su ser y su patrimonio.
          </p>
        </div>

      </div>
    </section>

    <!-- S8: CIERRE + CTA -->
    <section class="border-t border-gd-muted py-32 md:py-40">
      <div class="max-w-3xl mx-auto px-6 text-center">

        <div class="reveal">
          <p class="font-display text-4xl md:text-6xl font-semibold text-tx leading-tight mb-8">
            No vendo seguros.
            <br />
            <span class="text-gd italic">Diseño arquitectura financiera.</span>
          </p>

          <div class="h-px w-24 bg-gd mx-auto mb-10"></div>

          <p class="font-body text-base md:text-lg text-tx-muted leading-relaxed max-w-xl mx-auto mb-12">
            Si llegaste hasta acá, probablemente tengas una pregunta
            concreta o una decisión importante sobre tu patrimonio. La
            conversación empieza por WhatsApp. Sin formularios, sin
            filtros, sin compromiso.
          </p>

          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-lift inline-flex items-center justify-center gap-2 bg-gd px-8 py-4 rounded-md font-body font-medium text-base hover:bg-gd-light"
            style="color:#08080d"
          >
            Conversar conmigo por WhatsApp
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

        </div>

      </div>
    </section>

  </main>

  <Footer />

</Layout>
