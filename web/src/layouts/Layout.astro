---
import "../styles/global.css";
import { WHATSAPP_NUMERO } from "../lib/whatsapp";

/**
 * Layout base del sitio.
 * Incluye <head> con SEO completo + JSON-LD InsuranceAgency + Person.
 * Cada pagina puede override title, description, ogImage, canonical.
 *
 * Fuente unica de identidad: Brand Book 2026 + Plan Maestro v2.
 */

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Asesoría especializada en seguros de vida, salud e inversión en Ecuador. Patrimonio que crece. Capital protegido.",
  canonical,
  ogImage = "/og-default.png",
  noindex = false,
} = Astro.props;

const SITE_URL = "https://barreraglobal.com";
// Sin barra final, salvo la raiz. Las 5 paginas de producto ya pasan su
// canonical a mano SIN barra ("/inversion", "/seguros/vida-termino"); el
// fallback la agregaba ("/contacto/", "/sobre-mi/", "/privacidad/") y el
// sitio quedaba con dos formas de canonical. El sitemap solo puede declarar
// una: se normaliza a la forma que ya usaban las paginas de producto.
const pathname = Astro.url.pathname.replace(/(.+)\/$/, "$1");
const canonicalURL = canonical ?? new URL(pathname, SITE_URL).toString();
const ogImageURL = new URL(ogImage, SITE_URL).toString();

// Schema.org JSON-LD (insertado en todas las paginas)
const insuranceAgencySchema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "@id": `${SITE_URL}/#organization`,
  name: "Barrera Global",
  alternateName: "Barrera Global Arquitectura Financiera",
  description: "Asesoría especializada en seguros y planificacion financiera en Ecuador.",
  url: SITE_URL,
  logo: `${SITE_URL}/logo.svg`,
  image: ogImageURL,
  // El mismo numero que los enlaces de WhatsApp, importado de la fuente unica:
  // era la ultima copia a mano que quedaba en el sitio.
  telephone: `+${WHATSAPP_NUMERO}`,
  email: "fbarrera.inversiones@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ambato",
    addressRegion: "Tungurahua",
    addressCountry: "EC",
  },
  areaServed: {
    "@type": "Country",
    name: "Ecuador",
  },
  sameAs: [
    "https://www.facebook.com/profile.php?id=61583767980524",
    "https://www.instagram.com/franciscobarrera.ec/",
    "https://www.tiktok.com/@franciscobarrera.ec",
    "https://www.linkedin.com/in/franciscobarrera-ai/",
    "https://github.com/fbarrerainversiones",
  ],
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}/#francisco`,
  name: "Francisco Javier Barrera Bonilla",
  givenName: "Francisco",
  familyName: "Barrera Bonilla",
  jobTitle: "Asesor Productor de Seguros",
  description: "Asesor productor de seguros y especialista en automatización con IA.",
  url: `${SITE_URL}/sobre-mi`,
  worksFor: {
    "@id": `${SITE_URL}/#organization`,
  },
  affiliation: {
    "@type": "Organization",
    name: "Insurance Trust",
    url: "https://itbrokerec.com",
    description: "Broker ecuatoriano registrado en SCVS (Cred. Nº 572619)",
  },
  workLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Ambato",
      addressRegion: "Tungurahua",
      addressCountry: "EC",
    },
  },
  knowsLanguage: ["es-EC", "es"],
  sameAs: [
    "https://www.instagram.com/franciscobarrera.ec/",
    "https://www.linkedin.com/in/franciscobarrera-ai/",
    "https://github.com/fbarrerainversiones",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  url: SITE_URL,
  name: "Barrera Global",
  description: "Patrimonio que crece. Capital protegido.",
  publisher: {
    "@id": `${SITE_URL}/#organization`,
  },
  inLanguage: "es-EC",
};
---

<!doctype html>
<html lang="es-EC">
  <head>
    <!-- Charset y viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO basico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Idioma y region -->
    <meta http-equiv="content-language" content="es-EC" />
    <meta name="geo.region" content="EC-T" />
    <meta name="geo.placename" content="Ambato, Tungurahua, Ecuador" />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp link preview) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Barrera Global" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Theme color (barra navegador mobile) -->
    <meta name="theme-color" content="#08080d" />

    <!-- Iconos — portico P3 "Arquitectonica" (decision D-29).
         El SVG es el principal: escala a cualquier densidad sin pixelarse.
         El PNG de 32 es el fallback para navegadores que no toman SVG.
         apple-touch-icon va a sangre sobre #08080d porque iOS aplica su
         propia mascara de esquinas sobre la pieza que reciba. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Performance hints -->
    <meta name="generator" content={Astro.generator} />

    <!-- JSON-LD Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(insuranceAgencySchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>

  <body>
    <slot />

    <!-- Scroll reveal vanilla JS — unico para todo el sitio.
         Vive acá (y no en cada página) para que cualquier página que use
         .reveal muestre su contenido. Sin el, .reveal queda opacity:0
         permanente (ver global.css). Si cambia su contenido, REGENERAR el
         hash CSP de infra/nginx.conf (ver infra/README-hashes.md). -->
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
