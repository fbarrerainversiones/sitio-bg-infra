---
import Logo from "./Logo.astro";

/**
 * Despliegue de "Productos" — CSS puro, cero JavaScript nuevo.
 * El unico script de este componente (toggle del menu movil) NO se toca,
 * asi que los hashes CSP de infra/nginx.conf siguen validos.
 *
 * Desktop: se oculta con opacity + pointer-events, NO con hidden/invisible.
 * Un elemento con visibility:hidden no puede recibir foco, asi que
 * group-focus-within nunca dispararia y el menu quedaria inaccesible por
 * teclado. Con opacity los enlaces siguen en el orden de tabulacion y el
 * panel aparece tanto en hover como al tabular hacia el.
 *
 * Movil: <details>/<summary> nativo, sin JS. El script que cierra el menu
 * al hacer click solo escucha <a>, asi que abrir el submenu no lo cierra.
 */
type NavLink = {
  href: string;
  label: string;
  children?: { href: string; label: string }[];
};

// Paginas de producto que cuelgan de "Productos".
// /seguros/auto NO se lista: su existencia sigue pendiente de decision
// de Francisco (D1 en docs/REPORTE-SESION-10.md).
const PRODUCT_LINKS = [
  { href: "/seguros/vida-termino", label: "Vida a termino" },
  { href: "/seguros/vida-indexada", label: "Vida indexada" },
  { href: "/seguros/salud-nacional", label: "Salud nacional" },
  { href: "/seguros/salud-internacional", label: "Salud internacional" },
  { href: "/inversion", label: "Inversion" },
  { href: "/#productos", label: "Ver todos →" },
];

const NAV_LINKS: NavLink[] = [
  { href: "/#productos", label: "Productos", children: PRODUCT_LINKS },
  { href: "/sobre-mi", label: "Sobre mi" },
  { href: "/contacto", label: "Contacto" },
];

const WHATSAPP_AURORA = "593998027819";
const WHATSAPP_MESSAGE = encodeURIComponent(
  "Hola, llego desde barreraglobal.com y quiero conversar."
);
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_AURORA}?text=${WHATSAPP_MESSAGE}`;
---

<header class="sticky top-0 z-50 w-full border-b border-gd-muted bg-bg/85 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6">

    <Logo size="md" />

    <nav class="hidden md:flex items-center gap-8" aria-label="Navegacion principal">
      {NAV_LINKS.map((link) => link.children ? (
        <div class="relative group">
          <a
            href={link.href}
            class="font-body text-sm text-tx-muted hover:text-gd transition-colors"
          >
            {link.label}
          </a>
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 pointer-events-none transition-opacity duration-200 group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto">
            <ul class="min-w-56 border border-gd-muted rounded-md bg-bg-elev-1 py-2 shadow-lg">
              {link.children.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="block px-5 py-2.5 font-body text-sm text-tx-muted hover:text-gd hover:bg-bg-elev-2 transition-colors whitespace-nowrap"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          class="font-body text-sm text-tx-muted hover:text-gd transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-2 bg-gd text-[#08080d] px-5 py-2.5 rounded-md font-body font-medium text-sm hover:bg-gd-light transition-colors"
        aria-label="Conversar por WhatsApp con Barrera Global" style="color:#08080d"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
        </svg>
        <span>WhatsApp</span>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Abrir menu de navegacion"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-md text-tx hover:text-gd hover:bg-bg-elev-1 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-gd-muted bg-bg" aria-hidden="true">
    <nav class="px-6 py-4 flex flex-col gap-1" aria-label="Navegacion mobile">
      <p class="font-mono text-[10px] uppercase tracking-widest text-gd mb-2">Barrera Global</p>
      {NAV_LINKS.map((link) => link.children ? (
        <details class="group border-b border-gd-muted">
          <summary class="flex items-center justify-between py-3 font-body text-base text-tx hover:text-gd transition-colors cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span>{link.label}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gd transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <ul class="pb-3 pl-4 flex flex-col">
            {link.children.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block py-2 font-body text-sm text-tx-muted hover:text-gd transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ) : (
        <a
          href={link.href}
          class="block py-3 font-body text-base text-tx hover:text-gd transition-colors border-b border-gd-muted last:border-b-0"
        >
          {link.label}
        </a>
      ))}
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center justify-center gap-2 bg-gd text-[#08080d] px-5 py-3 rounded-md font-body font-medium text-sm" style="color:#08080d"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
        </svg>
        <span>Conversar por WhatsApp</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden") === false;
    if (isOpen) {
      menu?.classList.add("hidden");
      menu?.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menu de navegacion");
    } else {
      menu?.classList.remove("hidden");
      menu?.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menu de navegacion");
    }
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.setAttribute("aria-hidden", "true");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>






