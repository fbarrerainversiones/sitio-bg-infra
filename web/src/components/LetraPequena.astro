---
/**
 * Letra pequeña referencial — <details>/<summary> NATIVO, cero JavaScript.
 *
 * Reutilizable: hoy lo usan las tarjetas de aseguradora de /seguros/auto, y
 * sirve tal cual para replicar el patrón en los otros cinco productos.
 *
 * El patrón visual NO se inventa acá: se calca del <details> que ya existe en
 * `Header.astro:127` para el menú móvil — misma forma de ocultar el marcador
 * nativo (`list-none` + `[&::-webkit-details-marker]:hidden`), misma flecha
 * que rota con `group-open`. Un solo lenguaje de plegado en todo el sitio.
 *
 * Colapsado por defecto: `<details>` sin el atributo `open`.
 *
 * La etiqueta referencial va DENTRO del componente y no en cada página, para
 * que sea imposible publicar condiciones de producto sin ella.
 */
interface Props {
  /** Rótulo del resumen. Por defecto, el del ramo. */
  titulo?: string;
}

const { titulo = "Letra pequeña referencial" } = Astro.props;
---

<details class="group border-t border-gd-muted mt-6">
  <summary
    class="flex items-center justify-between gap-4 py-4 font-mono text-xs uppercase tracking-widest text-gd hover:text-gd-light transition-colors cursor-pointer list-none [&::-webkit-details-marker]:hidden"
  >
    <span>{titulo}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="shrink-0 transition-transform duration-200 group-open:rotate-180"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </summary>

  <div class="pb-5 font-body text-sm text-tx-muted leading-relaxed space-y-3">
    <slot />
    <p class="font-mono text-xs text-tx-disabled leading-relaxed pt-3 border-t border-gd-muted">
      Condiciones referenciales a agosto de 2026 — los términos finales se
      validan con las condiciones generales y particulares de cada póliza
      emitida.
    </p>
  </div>
</details>
